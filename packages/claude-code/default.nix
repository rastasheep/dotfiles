{ pkgs, claudePkgs }:

let
  inherit (pkgs) lib;
  dotfilesLib = import ../../lib { inherit pkgs; };

  claudeConfig = dotfilesLib.buildConfig {
    name = "claude";
    src = ./config;
  };

  # Pin a newer Claude Code than nixpkgs currently ships by overriding the
  # release manifest the upstream derivation reads (version + per-platform
  # checksums). Refresh with:
  #   curl -s https://downloads.claude.ai/claude-code-releases/<version>/manifest.zst.json \
  #     | python3 -m json.tool > packages/claude-code/manifest.zst.json
  # Drop this override once nixpkgs catches up to the desired version.
  claudeCode = claudePkgs.claude-code.override {
    manifest = lib.importJSON ./manifest.zst.json;
  };

  # Shell expression for the telemetry env file (shared by the wrapper and the
  # sync command below).
  envFile = "\${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/claude-code.env";

  # Writes envFile from 1Password. Runs from dotfiles-apply (activationCommand)
  # rather than on every launch, so claude itself never needs 1Password
  # unlocked. Rewrites on every run so a rotated token propagates; if op is
  # unavailable it warns, keeps any existing file, and exits 0 so the rest of
  # dotfiles-apply still runs.
  envSync = pkgs.writeShellScriptBin "claude-code-env-sync" ''
    set -euo pipefail
    op=${pkgs._1password-cli}/bin/op
    ref="op://Private/claude-code-2"
    envFile="${envFile}"

    if ! endpoint=$("$op" read "$ref/OTEL_EXPORTER_OTLP_METRICS_ENDPOINT" 2>/dev/null) \
      || ! headers=$("$op" read "$ref/OTEL_EXPORTER_OTLP_HEADERS" 2>/dev/null) \
      || ! attrs=$("$op" read "$ref/OTEL_RESOURCE_ATTRIBUTES" 2>/dev/null); then
      if [ -f "$envFile" ]; then
        echo "[WARN] claude-code-env-sync: could not read $ref from 1Password; keeping existing $envFile" >&2
      else
        echo "[WARN] claude-code-env-sync: could not read $ref from 1Password; claude telemetry stays off until the next successful run" >&2
      fi
      exit 0
    fi

    umask 077
    mkdir -p "$(dirname "$envFile")"
    tmp=$(mktemp "$envFile.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    {
      echo "# Generated by claude-code-env-sync (dotfiles-apply) from $ref. Do not edit."
      echo "CLAUDE_CODE_ENABLE_TELEMETRY=1"
      echo "OTEL_METRICS_EXPORTER=otlp"
      echo "OTEL_EXPORTER_OTLP_PROTOCOL=http/json"
      printf 'OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=%q\n' "$endpoint"
      printf 'OTEL_EXPORTER_OTLP_HEADERS=%q\n' "$headers"
      printf 'OTEL_RESOURCE_ATTRIBUTES=%q\n' "$attrs"
    } > "$tmp"
    mv -f "$tmp" "$envFile"
    trap - EXIT
    echo "[INFO] claude-code-env-sync: wrote $envFile"
  '';

  # Config sync and env, run on every launch
  commonSetup = ''
    # Ensure ~/.claude directory exists as a writable directory
    mkdir -p "$HOME/.claude"

    # Link only specific config files
    ${dotfilesLib.smartConfigLink {
      from = "${claudeConfig}/share/claude/settings.json";
      to = "$HOME/.claude/settings.json";
    }}

    # Link global CLAUDE.md instructions
    ${dotfilesLib.smartConfigLink {
      from = "${claudeConfig}/share/claude/CLAUDE.md";
      to = "$HOME/.claude/CLAUDE.md";
    }}

    # Sync commands: copy dotfiles commands while preserving marketplace-installed ones
    mkdir -p "$HOME/.claude/commands"
    if [ -L "$HOME/.claude/commands" ]; then
      rm -f "$HOME/.claude/commands"
      mkdir -p "$HOME/.claude/commands"
    fi
    cp -f ${claudeConfig}/share/claude/commands/* "$HOME/.claude/commands/" 2>/dev/null || true

    # Sync skills: copy dotfiles skills while preserving marketplace-installed ones
    mkdir -p "$HOME/.claude/skills"
    if [ -L "$HOME/.claude/skills" ]; then
      rm -f "$HOME/.claude/skills"
      mkdir -p "$HOME/.claude/skills"
    fi
    if [ -d "${claudeConfig}/share/claude/skills" ]; then
      cp -rf ${claudeConfig}/share/claude/skills/* "$HOME/.claude/skills/" 2>/dev/null || true
    fi

    # Machine-local env (OTEL telemetry endpoint and auth header), written by
    # claude-code-env-sync during dotfiles-apply. Kept out of this repo because
    # it holds secrets; when the file is absent, claude runs with no telemetry.
    envFile="${envFile}"
    if [ -r "$envFile" ]; then
      set -a
      . "$envFile"
      set +a
    fi
  '';

  claudeWrapper = pkgs.writeShellScriptBin "claude" ''
    ${commonSetup}

    exec ${claudeCode}/bin/claude "$@"
  '';

  # ACP adapter (Agent Client Protocol: editors like Write or Zed run Claude as an
  # agent over stdio). Node lives only in its closure, not on PATH; the Claude it
  # runs is the wrapper above (settings, CLAUDE.md, local env), not nixpkgs' own
  # claude-code.
  claudeAgentAcp = claudePkgs.claude-agent-acp.override {
    claude-code = claudeWrapper;
  };
in
pkgs.buildEnv {
  name = "claude-code-configured";
  paths = [
    claudeWrapper
    claudeAgentAcp
    envSync
    claudeConfig
  ];
  pathsToLink = [ "/bin" "/share" ];

  passthru = {
    unwrapped = claudeCode;
    version = claudeCode.version or "unknown";
    activationCommand = "claude-code-env-sync";
  };

  meta = {
    description = "Claude Code with custom config, and its ACP adapter";
    homepage = "https://claude.ai/code";
    platforms = lib.platforms.darwin;
    mainProgram = "claude";
  };
}
